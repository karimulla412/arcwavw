# Arcwave Pilates — environment variables
# Copy this file to `.env` and fill in your real MySQL credentials.

# MySQL database connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first, e.g. in MySQL CLI:
#   CREATE DATABASE arcwave_pilates CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:password@localhost:3306/arcwave_pilates

# Optional: secret used to sign admin session cookies.
# If unset, a default dev secret is used. Set a long random string in production.
# SESSION_SECRET=replace-with-a-long-random-string

# ───────────────────────────────────────────────────────────────────────────
# Razorpay — paste your real keys here to enable live payments.
# Until both RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set, the checkout
# flow automatically falls back to the built-in MOCK mode (auto-success), so
# the site keeps working in development.
#
# Get these from: https://dashboard.razorpay.com/app/keys
# ───────────────────────────────────────────────────────────────────────────

# Your Razorpay Key ID (starts with rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=

# Your Razorpay Key Secret (paired with the Key ID above)
RAZORPAY_KEY_SECRET=

# (Optional) Webhook secret from https://dashboard.razorpay.com/app/webhooks
# Only needed if you plan to enable server-to-server webhooks later.
RAZORPAY_WEBHOOK_SECRET=

# Public mirror of RAZORPAY_KEY_ID so the browser can open the checkout modal.
# Must be the same value as RAZORPAY_KEY_ID. (NEXT_PUBLIC_* vars are exposed
# to the client — that is expected and safe: this is a *public* key.)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
