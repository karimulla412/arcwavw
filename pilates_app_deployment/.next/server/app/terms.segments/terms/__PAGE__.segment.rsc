8:["$","section",null,{"id":"conduct","className":"scroll-mt-20","children":[["$","h2",null,{"className":"text-2xl font-medium text-ink md:text-3xl","children":"8. Studio code of conduct"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-relaxed text-ink/90","children":[["$","p",null,{"children":"We work hard to keep the Studio a calm, respectful, and safe space for everyone. By attending a class you agree to:"}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":"Arrive on time and stay for the full session where possible."}],["$","li",null,{"children":"Follow the trainer's instructions, including any safety or equipment guidance."}],["$","li",null,{"children":"Treat trainers, fellow clients, and Studio property with respect."}],["$","li",null,{"children":"Refrain from using your phone in the practice area, and from any behaviour that disrupts the class."}]]}],["$","p",null,{"children":"The Studio may refuse entry, ask a client to leave a session, or cancel a membership without refund where conduct is, in our reasonable judgement, unsafe, abusive, or disruptive."}]]}]]}]
