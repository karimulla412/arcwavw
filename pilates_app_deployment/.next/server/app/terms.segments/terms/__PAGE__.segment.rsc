4:["$","section",null,{"id":"memberships","className":"scroll-mt-20","children":[["$","h2",null,{"className":"text-2xl font-medium text-ink md:text-3xl","children":"4. Memberships, plans & pricing"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-relaxed text-ink/90","children":[["$","p",null,{"children":"Memberships and class packs are sold on the terms described on the pricing page at the time of purchase. Each plan specifies its duration (in months), the number of classes per week, the total number of sessions included, any bonus sessions, and the price."}],["$","p",null,{"children":["A membership becomes ",["$","strong",null,{"children":"active"}]," only after the full payment for that plan has been successfully received. Trial classes, where offered, are subject to availability and may be limited to one per person."]}],["$","p",null,{"children":"The Studio may revise plan prices and features at any time. Any change applies only to purchases made after the change takes effect — your existing active membership continues on the terms you paid for."}]]}]]}]
5:["$","section",null,{"id":"carry-forward","className":"scroll-mt-20","children":[["$","h2",null,{"className":"text-2xl font-medium text-ink md:text-3xl","children":"5. Carry-forward of sessions"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-relaxed text-ink/90","children":[["$","p",null,{"children":"Where a plan allows carry-forward, any unused sessions from a previous active membership that is close to expiry (within 30 days of its end date) or recently expired (within the last 30 days) may be carried into a new membership purchased within that window. The number of sessions carried forward is capped by the new plan's carry-forward policy and is recorded in the membership notes."}],["$","p",null,{"children":"Carry-forward is not a cash refund or credit toward another plan. It applies only to sessions, and only once, at the moment of renewal."}]]}]]}]
6:["$","section",null,{"id":"booking-cancellation","className":"scroll-mt-20","children":[["$","h2",null,{"className":"text-2xl font-medium text-ink md:text-3xl","children":"6. Booking, rescheduling & cancellations"}],["$","div",null,{"className":"mt-4 space-y-4 text-base leading-relaxed text-ink/90","children":[["$","p",null,{"children":"Class sizes are limited and many sessions fill up. Once a slot is locked to your membership it is reserved for you. If you cannot attend, please cancel your booking through your account dashboard at the earliest, so the slot can be released to another member or to the waitlist."}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":"Cancellations made more than 12 hours before the scheduled class time will release the session back to your membership balance."}],["$","li",null,{"children":"Late cancellations (less than 12 hours before class) or no-shows may be counted as a used session at the Studio's discretion."}],["$","li",null,{"children":"Repeated no-shows may result in your booking privileges being restricted."}]]}],["$","p",null,{"children":"The Studio reserves the right to cancel or reschedule a class where a trainer is unavailable or for other operational reasons. Where possible, we will offer a substitute slot or a credit toward a future class."}]]}]]}]
